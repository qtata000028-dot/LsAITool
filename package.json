{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run full-dev",
    "dev:vscode": "node scripts/restart-client-with-api.mjs",
    "client": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "host": "tsx watch server/index.ts",
    "subapp": "node scripts/dev-subapp.mjs",
    "full-dev": "node scripts/dev-with-simple-designer.mjs",
    "dev:client": "npm run client",
    "dev:api": "npm run host",
    "dev:host": "node scripts/dev-with-api.mjs",
    "dev:simple-designer": "npm run full-dev",
    "dev:subapp": "npm run subapp",
    "prebuild": "node scripts/build-simple-designer-bundle.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "clean": "rm -rf dist",
    "guard:architecture": "node scripts/check-architecture-guards.mjs",
    "lint": "eslint .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "verify:strict": "npm run guard:architecture && npm run verify"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.29.0",
    "@onlyoffice/document-editor-react": "^2.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "^0.8.11",
    "antd": "^6.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.36.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable": "^3.1.3",
    "react-rnd": "^10.5.3",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.2.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
