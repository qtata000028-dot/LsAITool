{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Full App",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/dev-with-api.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Run App in Safari",
      "type": "node-terminal",
      "request": "launch",
      "command": "open -a Safari http://127.0.0.1:3000",
      "preLaunchTask": "ensure-client-dev-server"
    },
    {
      "name": "Start Full Dev Stack Only",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    }
  ]
}
