{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run App in Edge",
      "type": "pwa-msedge",
      "request": "launch",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "ensure-dev-server"
    },
    {
      "name": "Run App in Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "ensure-dev-server"
    },
    {
      "name": "Start Vite Dev Server Only",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    }
  ]
}
