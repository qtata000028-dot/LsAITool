{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run App in Installed Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "runtimeExecutable": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "ensure-dev-server"
    },
    {
      "name": "Start Vite Dev Server Only",
      "type": "node-terminal",
      "request": "launch",
      "command": "/bin/zsh -lc 'source ~/.zshrc >/dev/null 2>&1 && npm run dev'"
    }
  ]
}
